# ─────────────────────────────────────────────────────────────────────────────
# Pojulu Heritage Foundation — environment variables
# Copy to .env for local development. On Railway, set these as service
# variables. Every value below is a safe placeholder. See docs/HARDENING.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Required when DEBUG=False. Generate with:
#   py -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-value
# Default False. Use True only on your own machine.
DEBUG=True
# Comma-separated. Railway's RAILWAY_PUBLIC_DOMAIN is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme. Wildcards allowed: https://*.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Railway sets DATABASE_URL. If unset, the DB_* values below build a URL for
# the local docker-compose Postgres (port 5435).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_NAME=pojulu_heritage
DB_USER=postgres
DB_PASSWORD=change-me-local-db-password
DB_HOST=localhost
DB_PORT=5435

# ── Django admin (off by default) ────────────────────────────────────────────
ENABLE_DJANGO_ADMIN=False
# Use an unguessable prefix if you ever enable it in production.
ADMIN_URL_PREFIX=admin/

# ── HTTPS / HSTS (only applied when DEBUG=False) ─────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=True

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Pojulu Heritage Foundation <noreply@example.org>

# ── Gunicorn (read by Procfile / Dockerfile) ─────────────────────────────────
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ── Authentication ───────────────────────────────────────────────────────────
# Reverse proxies that append to X-Forwarded-For (Railway = 1, local = 0).
# Defaults to 0 when DEBUG=True and 1 when DEBUG=False.
TRUSTED_PROXY_COUNT=0
# django-axes brute-force lockout (5 failures per username+IP -> 1 hour).
AXES_ENABLED=True

# ── Media storage ────────────────────────────────────────────────────────────
# Leave AWS_STORAGE_BUCKET_NAME empty to store media on local disk (dev).
# Railway's disk is wiped on every deploy, so production MUST use a bucket.
# Cloudflare R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto
# Backblaze B2:  endpoint https://s3.<region>.backblazeb2.com, region <region>
AWS_STORAGE_BUCKET_NAME=
AWS_PRIVATE_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Public URL of the PUBLIC bucket (custom domain / r2.dev). Requires a separate
# private bucket. Leave empty to serve public files via signed URLs too.
MEDIA_PUBLIC_BASE_URL=
# Lifetime of signed URLs for private files, in seconds.
PRIVATE_MEDIA_URL_EXPIRE=300
# Local private media directory (dev only; outside MEDIA_ROOT).
# PRIVATE_MEDIA_ROOT=./private_media
